// Inspect: the edge crosses adjacent container gaps instead of visiting root:N/S.
hbox root {
  vbox center {
    hbox upper {
      node u1 "U1"
      node u2 "U2"
      node u3 "U3"
    }
    hbox lower {
      node l1 "L1"
      node l2 "L2"
      node l3 "L3"
    }
  }
  vbox east {
    node e1 "E1"
    node e2 "E2"
  }
}

edges {
  u1 -> e2
}
